{
  "openapi": "3.1.0",
  "info": {
    "title": "image2ppt-vision",
    "version": "0.3.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "Capabilities",
        "operationId": "capabilities_v1_capabilities_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assets": {
      "post": {
        "summary": "Upload",
        "operationId": "upload_v1_assets_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_v1_assets_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "summary": "Submit",
        "operationId": "submit_v1_jobs_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "summary": "Status",
        "operationId": "status_v1_jobs__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}/artifacts/{name}": {
      "get": {
        "summary": "Artifact",
        "operationId": "artifact_v1_jobs__id__artifacts__name__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Author": {
        "properties": {
          "tool": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Tool"
          },
          "model_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Model Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool",
          "model_id"
        ],
        "title": "Author"
      },
      "Body_upload_v1_assets_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_v1_assets_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LineStyle": {
        "properties": {
          "color": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{6}$",
            "title": "Color"
          },
          "width_px": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Width Px"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "color",
          "width_px"
        ],
        "title": "LineStyle"
      },
      "ReconstructionPlan": {
        "properties": {
          "schema": {
            "type": "string",
            "const": "ReconstructionPlan",
            "title": "Schema",
            "default": "ReconstructionPlan"
          },
          "version": {
            "type": "string",
            "enum": [
              "1.0",
              "1.1"
            ],
            "title": "Version",
            "default": "1.0"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Sha256"
          },
          "image_size": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Image Size"
          },
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/Region"
            },
            "type": "array",
            "maxItems": 256,
            "minItems": 1,
            "title": "Regions"
          },
          "text_overrides": {
            "items": {
              "$ref": "#/components/schemas/TextOverride"
            },
            "type": "array",
            "maxItems": 2000,
            "title": "Text Overrides"
          },
          "retain_raster_ids": {
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "type": "array",
            "maxItems": 2000,
            "title": "Retain Raster Ids"
          },
          "shapes": {
            "items": {
              "$ref": "#/components/schemas/Shape"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Shapes"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/TableProposal"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Tables"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_sha256",
          "image_size",
          "author",
          "regions"
        ],
        "title": "ReconstructionPlan"
      },
      "Region": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Id"
          },
          "bbox": {
            "items": {
              "type": "number",
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox"
          },
          "kind": {
            "type": "string",
            "enum": [
              "panel",
              "photo",
              "diagram",
              "header",
              "footer"
            ],
            "title": "Kind"
          },
          "label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "bbox",
          "kind"
        ],
        "title": "Region"
      },
      "Request": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "analyze",
              "segment",
              "extract",
              "compare",
              "reconstruct",
              "reconstruct_elements"
            ],
            "title": "Operation"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Asset Id"
          },
          "reference_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Id"
          },
          "mask_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mask Id"
          },
          "bbox": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array",
                "maxItems": 4,
                "minItems": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox"
          },
          "points": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "maxItems": 64,
            "title": "Points"
          },
          "labels": {
            "items": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "type": "array",
            "maxItems": 64,
            "title": "Labels"
          },
          "mode": {
            "type": "string",
            "enum": [
              "automatic",
              "prompt"
            ],
            "title": "Mode",
            "default": "automatic"
          },
          "crop_prompt": {
            "type": "boolean",
            "title": "Crop Prompt",
            "default": false
          },
          "ocr": {
            "type": "boolean",
            "title": "Ocr",
            "default": true
          },
          "segment": {
            "type": "boolean",
            "title": "Segment",
            "default": false
          },
          "resize_reference": {
            "type": "boolean",
            "title": "Resize Reference",
            "default": false
          },
          "register_translation": {
            "type": "boolean",
            "title": "Register Translation",
            "default": false
          },
          "timeout_seconds": {
            "type": "integer",
            "maximum": 1800.0,
            "minimum": 1.0,
            "title": "Timeout Seconds",
            "default": 300
          },
          "plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReconstructionPlan"
              },
              {
                "type": "null"
              }
            ]
          },
          "element_inventory": {
            "type": "boolean",
            "title": "Element Inventory",
            "default": false
          },
          "analysis_job_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Job Id"
          },
          "element_plan": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Element Plan"
          },
          "renderer_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Renderer Version"
          },
          "typography_policy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "diagnostic",
                  "color",
                  "typography"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Typography Policy"
          },
          "geometry_policy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "diagnostic",
                  "measured"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometry Policy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation",
          "asset_id"
        ],
        "title": "Request"
      },
      "Shape": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Id"
          },
          "bbox": {
            "items": {
              "type": "number",
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox"
          },
          "geometry": {
            "type": "string",
            "enum": [
              "rect",
              "roundRect",
              "ellipse",
              "line",
              "chevron",
              "pentagon",
              "rightArrow",
              "leftArrow",
              "trapezoid",
              "parallelogram",
              "hexagon",
              "diamond",
              "triangle"
            ],
            "title": "Geometry"
          },
          "fill": {
            "type": "string",
            "pattern": "^(?:[A-Fa-f0-9]{6}|none)$",
            "title": "Fill"
          },
          "line": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LineStyle"
              },
              {
                "type": "null"
              }
            ]
          },
          "corner_radius_px": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Corner Radius Px"
          },
          "native_only_if_verified": {
            "type": "boolean",
            "const": true,
            "title": "Native Only If Verified",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "bbox",
          "geometry",
          "fill"
        ],
        "title": "Shape"
      },
      "TableMerge": {
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Row"
          },
          "column": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Column"
          },
          "row_span": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Row Span",
            "default": 1
          },
          "column_span": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Column Span",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "row",
          "column"
        ],
        "title": "TableMerge"
      },
      "TableProposal": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$",
            "title": "Id"
          },
          "region_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Region Id"
          },
          "bbox": {
            "items": {
              "type": "number",
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox"
          },
          "rows": {
            "items": {
              "items": {
                "type": "string",
                "maxLength": 2048
              },
              "type": "array"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Rows"
          },
          "column_widths": {
            "items": {
              "type": "number",
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Column Widths"
          },
          "row_heights": {
            "items": {
              "type": "number",
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Row Heights"
          },
          "ocr_ids": {
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "type": "array",
            "maxItems": 2000,
            "title": "Ocr Ids"
          },
          "merges": {
            "items": {
              "$ref": "#/components/schemas/TableMerge"
            },
            "type": "array",
            "maxItems": 2000,
            "title": "Merges"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "region_id",
          "bbox",
          "rows",
          "column_widths",
          "row_heights",
          "ocr_ids"
        ],
        "title": "TableProposal"
      },
      "TextOverride": {
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Target Id"
          },
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "expected_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_id",
          "text",
          "reason"
        ],
        "title": "TextOverride"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
